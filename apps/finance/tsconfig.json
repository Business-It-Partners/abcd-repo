{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "react": ["node_modules/@types/react/index.d.ts"],
      "react/*": ["node_modules/@types/react/*"],
      "lucide-react": ["node_modules/lucide-react/dist/lucide-react.d.ts"],
      "@sbmdkl/nepali-date-converter": ["node_modules/@sbmdkl/nepali-date-converter/types/index.d.ts"],
      "@/shared/*": ["src/shared/*"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}
