{
  "name": "electron-desktop-prototype",
  "version": "0.1.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "publish:development-app": "node tools/development-apps/publish.mjs",
    "preview:browser": "node tools/development-apps/preview-browser.mjs",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "pretest": "node tools/app-packages/build-appointments-m17.mjs",
    "test": "vitest run --exclude \"apps/dental-apps/**\"",
    "test:electron": "node tools/run-ui-test.mjs tests/electron.mjs",
    "test:scaling": "node tools/run-ui-test.mjs tests/scaling.mjs",
    "test:records": "node tools/run-ui-test.mjs tests/records.mjs",
    "test:windows": "node tools/run-ui-test.mjs tests/windows.mjs",
    "test:native-session": "node tools/run-ui-test.mjs tests/native-session.mjs",
    "test:followups": "node tools/run-ui-test.mjs tests/followups.mjs",
    "test:work-entry": "node tools/run-ui-test.mjs tests/m17-work-entry.mjs",
    "test:lab-tracker": "node tools/run-ui-test.mjs tests/m17-lab-tracker.mjs",
    "test:lab-tracker:contract": "node --test apps/dental-apps/company.dental.lab-tracker.m17/tests/*.test.mjs",
    "build:lab-tracker": "npm --prefix apps/dental-apps/company.dental.lab-tracker.m17 run build",
    "build:finance": "npm --prefix apps/dental-apps/company.dental.finance.m17 run build",
    "test:patient-record": "node tools/run-ui-test.mjs tests/m17-patient-record.mjs",
    "build:patient-record": "npm --prefix apps/dental-apps/company.dental.patient-record.m17 run build",
    "test:treatment-protocols": "node tools/run-ui-test.mjs tests/m17-treatment-protocols.mjs",
    "test:ui": "node tools/run-ui-test.mjs tests/store.mjs tests/labs.mjs tests/staff.mjs tests/overview.mjs tests/finance.mjs tests/dockapps.mjs tests/followups.mjs tests/records.mjs tests/windows.mjs tests/electron.mjs tests/native-session.mjs tests/scaling.mjs",
    "test:dockapps": "node tools/run-ui-test.mjs tests/dockapps.mjs",
    "test:finance": "node tools/run-ui-test.mjs tests/finance.mjs",
    "test:finance-sidebar": "node tools/run-ui-test.mjs tests/m15-finance-sidebar.mjs",
    "test:overview": "node tools/run-ui-test.mjs tests/overview.mjs",
    "test:staff": "node tools/run-ui-test.mjs tests/staff.mjs",
    "test:clarity": "node tools/run-ui-test.mjs tests/clarity.mjs",
    "test:labs": "node tools/run-ui-test.mjs tests/labs.mjs",
    "test:store": "node tools/run-ui-test.mjs tests/store.mjs",
    "test:store-interruptions": "node tools/run-ui-test.mjs tests/store-interruptions.mjs",
    "dist:windows": "node tools/desktop-release/build-windows.mjs",
    "test:windows-package": "node tools/run-ui-test.mjs tests/windows-package.mjs",
    "test:runtime": "node tools/run-ui-test.mjs tests/runtime.mjs tests/runtime-dpr.mjs",
    "test:runtime-resize": "node tools/run-ui-test.mjs tests/runtime-resize.mjs",
    "test:app-launch-feedback": "node tools/run-ui-test.mjs tests/app-launch-feedback.mjs",
    "test:sdk": "node tools/run-ui-test.mjs tests/sdk.mjs",
    "test:identity": "node tools/run-ui-test.mjs tests/identity.mjs",
    "test:identity-recovery": "node tools/run-ui-test.mjs tests/identity-recovery.mjs",
    "test:packages": "node tools/run-ui-test.mjs tests/packages.mjs",
    "test:integration": "node tools/run-ui-test.mjs tests/integration.mjs",
    "test:updates": "node tools/run-ui-test.mjs tests/updates.mjs",
    "test:distribution": "node tools/run-ui-test.mjs tests/distribution.mjs",
    "test:workspace": "node tools/run-ui-test.mjs tests/workspace-flows.mjs tests/delivery-states.mjs",
    "test:hardening": "node tools/run-ui-test.mjs tests/hardening.mjs tests/resources.mjs tests/recovery.mjs",
    "test:shell-recovery": "node tools/run-ui-test.mjs tests/shell-recovery.mjs",
    "test:store-arrival": "node tools/run-ui-test.mjs tests/store-arrival-delivery.mjs",
    "test:development-apps": "node tools/run-ui-test.mjs tests/development-apps.mjs",
    "test:onboarding": "node tools/run-ui-test.mjs tests/onboarding.mjs",
    "test:staging-onboarding-desktop": "node tools/run-ui-test.mjs tests/staging-onboarding-desktop.mjs",
    "test:staging-media-dock": "node tools/run-ui-test.mjs tests/media-staging-dock.mjs",
    "test:app-failure-containment": "node tools/run-ui-test.mjs tests/app-failure-containment.mjs",
    "test:resource-pressure": "node tools/run-ui-test.mjs tests/resource-pressure.mjs",
    "test:windows-safe-storage": "node tools/desktop-release/windows-safe-storage/run.mjs",
    "check:toolchain": "node tools/desktop-release/check-toolchain.mjs"
  },
  "keywords": [],
  "author": "Sajilo Dental",
  "license": "UNLICENSED",
  "description": "Sajilo Dental desktop workspace for clinic teams",
  "dependencies": {
    "lucide-react": "^1.56.0",
    "nepali-date-utils": "1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@sbmdkl/nepali-date-converter": "2.0.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "private": true
}
